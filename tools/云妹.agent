ference","dataType":"String","enable":true,"name":"companion","require":false,"systemVariable":false},{"bindValue":"62106282.parsed_info.duration","bindValueType":"Reference","dataType":"String","enable":true,"name":"duration","require":false,"systemVariable":false},{"bindValue":"62106284.outputList","bindValueType":"Reference","dataType":"Array_Object","enable":true,"name":"outputList","require":false,"systemVariable":false}],"maxTokens":4096,"mode":"Customization","modelId":299438,"outputArgs":[{"dataType":"String","enable":true,"key":"62106296.markdown_text","name":"markdown_text","require":false,"systemVariable":false}],"outputType":"Text","skillComponentConfigs":[],"systemPrompt":"你是川蜀文旅规划专家。根据用户偏好和知识库内容，生成一份行程规划。\n\n","temperature":1.0,"topP":0.7,"userPrompt":"用户偏好：{{preference}}\n同行人：{{companion}}\n可用时长：{{duration}}\n知识库检索结果：{{outputList}}\n请直接输出一份行程规划，用 Markdown 格式。\n格式要求：\n## 行程标题\n**上午 08:00-12:00 | 景点名**\n一句话介绍（不超过30字）。\n**下午 13:30-17:30 | 景点名**\n一句话介绍（不超过30字）。\n---\n**贴士**：一句话提醒。\n⚠️ 严格禁止：\n- 不要输出 <think> 标签\n- 不要输出任何代码、不要 OpenUI Lang、不要 root = Stack\n- 不要输出 JSON\n- 不要任何解释说明\n- 直接输出 Markdown 正文\n\n"},"preNodes":[],"spaceId":53260111,"type":"LLM","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5263143},{"created":"2026-09-19 13:24:14","description":"调用大语言模型，使用变量和提示词生成回复","id":62106477,"innerEndNode":false,"modified":"2026-09-20 01:43:12","name":"大模型","nextNodeIds":[62106268],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":902,"width":220,"y":286,"height":79},"inputArgs":[],"maxTokens":4096,"mode":"Balanced","modelId":299438,"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"String","description":"输出结果","enable":true,"key":"62106477.reply_text","name":"reply_text","require":false,"systemVariable":false}],"outputType":"Text","skillComponentConfigs":[],"systemPrompt":"用户说了一句话，但不是行程规划请求。请友好回复，并引导用户说出行程规划需求。\n\n","temperature":0.7,"topP":0.7,"userPrompt":"用户输入：{{input}}\n\n回复要求：热情、简短，最后引导用户说“你可以告诉我你想去哪里、玩几天、有什么偏好，我来帮你规划行程”。"},"preNodes":[],"spaceId":53260111,"type":"LLM","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5263143},{"created":"2026-09-19 23:56:30","description":"编写代码，处理输入变量来生成返回值","id":62109830,"innerEndNode":false,"modified":"2026-09-20 09:24:03","name":"代码","nextNodeIds":[62106268],"nextNodes":[],"nodeConfig":{"codeJavaScript":"// Import JS plugins. Supports multiple forms: HTTP(s), npm packages, JSR ESM modules, Node built-in utilities, or search for needed plugins at https://deno.land/x\n// For network requests, you can use fetch directly. Refer to the fetch documentation for details.\n// Input: Parameters are uniformly wrapped in args, e.g., args.a, args.b\n// Output: Must be a JSON object, e.g., {message:\"hello\"} where the output key is \"message\"\n// Dependency examples:\n//import * as o from 'https://deno.land/x/cowsay/mod.ts'\n//import axios from 'npm:axios';\n//import { Buffer } from \"node:buffer\";\n//import { delay } from \"jsr:@std/async\";\n\n// First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n// The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\nexport default async function main(args) {\n    const raw = args.markdown_text || '';\n    const cleaned = raw.replace(/<think>[\\s\\S]*?<\\/think>/g, '').trim();\n    return {\n        clean_source: cleaned\n    };\n}","codeLanguage":"JavaScript","codePython":"# Use import to bring in dependencies, or use importlib for dynamic imports.\n# Here is an example that creates a simple DataFrame:\n# import pandas as pd\n#\n#data = {\n#    'Name': ['Alice', 'Bob', 'Charlie'],\n#    'Age': [25, 30, 35]\n#}\n#df = pd.DataFrame(data)\n\n# First execution with dependencies may be slow and timeout. If it times out during test run, try again after a few minutes.\n# The entry function must not be modified, otherwise it cannot be executed. args are the configured input parameters.\ndef main(args: dict) -> dict:\n\n    params = args.get(\"params\")\n    # Build output object, keys must match configured output parameters.\n    ret = {\n        \"key\": \"value\"\n    }\n    return ret\n","exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":1760,"width":220,"y":-330,"height":79},"inputArgs":[{"bindValue":"62106296.markdown_text","bindValueType":"Reference","dataType":"String","enable":true,"name":"markdown_text","require":false,"systemVariable":false}],"outputArgs":[{"bindValue":"","bindValueType":"Input","dataType":"String","description":"","enable":true,"key":"62109830.clean_source","name":"clean_source","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260111,"type":"Code","unreachableNextNodeIds":[],"virtualExecute":false,"workflowId":5263143}],"outputArgs":[{"bindValue":"62109830.clean_source","bindValueType":"Reference","dataType":"String","enable":true,"key":"62106268.clean_source","name":"clean_source","require":false,"systemVariable":false}],"publishDate":"2026-09-20 09:39:02","publishStatus":"Published","publishedSpaceIds":[53260111],"scope":"Space","spaceId":53260111,"startNode":{"created":"2026-09-19 11:17:04","description":"工作流起始节点，用于设定启动工作流需要的信息","id":62106269,"innerEndNode":false,"modified":"2026-09-19 11:18:35","name":"开始","nextNodeIds":[62106270],"nextNodes":[],"nodeConfig":{"exceptionHandleConfig":{"exceptionHandleNodeIds":[],"exceptionHandleType":"INTERRUPT","retryCount":0,"specificContent":{},"timeout":180},"extension":{"x":30,"width":220,"y":70,"height":44},"inputArgs":[{"dataType":"String","description":"input message","enable":true,"key":"1785ccf0-5e44-4d01-93e5-9c646e1702f1","name":"input","require":false,"systemVariable":false}]},"preNodes":[],"spaceId":53260111,"type