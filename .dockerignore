# =============================================================================
# Docker 构建上下文精简：只保留后端 Maven 工程，加速镜像构建
# =============================================================================

# 版本控制与 IDE
.git/
.gitignore
.idea/
.vscode/
.mvn/

# Maven Wrapper（镜像内用 maven 镜像构建，无需 wrapper）
mvnw
mvnw.cmd

# 前端工程（由 EdgeOne Pages 单独托管）
shuyun-vue/
dist.zip

# 本地编译产物（镜像内重新编译）
**/target/

# 文档、数据源与工具（不参与后端构建）
docs/
shuyun-data/
tools/
*.md
